# Used by docker-compose.yml. Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Only needed for the first-time seed (min 12 chars):
SEED_ADMIN_PASSWORD=
# Port the site is served on (80 = plain http://<server-ip>). Use 8080 to run next to another web server.
HTTP_PORT=80
