{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "dtoFileNameSuffix": [".controller.ts", ".service.ts", ".dto.ts", "paging.ts"],
          "controllerFileNameSuffix": [".controller.ts"],
          "introspectComments": true
        }
      }
    ]
  }
}
